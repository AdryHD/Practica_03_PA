<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Práctica 3 - Programación Avanzada</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/bootstrap.css">
    <link rel="stylesheet" href="~/Content/perfect-scrollbar.css">
    <link rel="stylesheet" href="~/Content/bootstrap-icons.css">
    <link rel="stylesheet" href="~/Content/app.css">
    <link rel="stylesheet" href="~/Content/custom.css">
</head>

<body>
    <div id="app">
        <div id="sidebar" class="active">
            <div class="sidebar-wrapper active">
                <div class="sidebar-header">
                    <div class="d-flex justify-content-between">
                        <div class="logo">
                            <a href="@Url.Action("Consulta","Home")"><img src="~/Content/images/logo.png" alt="Logo"></a>
                        </div>
                        <div class="toggler">
                            <a href="#" class="sidebar-hide d-xl-none d-block"><i class="bi bi-x bi-middle"></i></a>
                        </div>
                    </div>
                </div>
                <div class="sidebar-menu">
                    <ul class="menu">
                        <li class="sidebar-item @(ViewContext.RouteData.Values["action"].ToString() == "Consulta" ? "active" : string.Empty)">
                            <a href="@Url.Action("Consulta", "Home")" class='sidebar-link'>
                                <i class="bi bi-table"></i>
                                <span>Consulta</span>
                            </a>
                        </li>
                        <li class="sidebar-item @(ViewContext.RouteData.Values["action"].ToString() == "Registro" ? "active" : string.Empty)">
                            <a href="@Url.Action("Registro", "Home")" class='sidebar-link'>
                                <i class="bi bi-cash-stack"></i>
                                <span>Registro</span>
                            </a>
                        </li>

                    </ul>
                </div>
                <button class="sidebar-toggler btn x"><i data-feather="x"></i></button>
            </div>
        </div>
        <div id="main">
            <header class="mb-3">
                <nav class="navbar navbar-expand navbar-header">
                    <a href="#" class="burger-btn d-block d-xl-none">
                        <i class="bi bi-justify fs-3"></i>
                    </a>

                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <div class="bienvenida-header">
                                    <i class="bi bi-mortarboard-fill bienvenida-icono"></i>
                                    <div class="bienvenida-texto">
                                        <span class="bienvenida-titulo">Programación Avanzada</span>
                                        <span class="bienvenida-subtitulo">Sistema de Gestión de Abonos</span>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </nav>
            </header>

            <div class="page-heading">
                <div class="bienvenida-banner">
                    <i class="bi bi-stars"></i>
                    <span>Bienvenidos al Sistema</span>
                    <i class="bi bi-stars"></i>
                </div>

                @RenderBody()

            </div>

            <footer>
                <div class="footer clearfix mb-0 text-muted">
                    <div class="float-start">
                        <p>@DateTime.Now.Year &copy; Mazer</p>
                    </div>
                    <div class="float-end">
                        <p>
                            Programación Avanzada
                        </p>
                    </div>
                </div>
            </footer>
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="~/Scripts/perfect-scrollbar.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/main.js"></script>
    @if (ViewBag.ScriptFile != null)
    {
        <script src="@Url.Content("~/Scripts/" + ViewBag.ScriptFile)"></script>
    }
</body>

</html>